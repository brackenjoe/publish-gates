#
# Refuse a push to a public GitHub repo unless the owner's approval is on the
# command. A public remote needs the owner's approval on every push, because
# publishing cannot be undone. This makes that rule a mechanism, not a habit.
# Git passes $1 the remote name and $2 its URL and feeds the refs on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>".
#
# Second job: for a push to any github.com repo EXCEPT one that
# check-visibility reports "public" (a public repo's history is public
# anyway) it scans the full message of every commit being pushed for a GitHub
# cross-reference (owner/repo#N, owner/repo@sha, a github.com issue, pull,
# commit or discussions URL) and refuses the push on a hit. GitHub posts the
# commit's title on the public item's timeline when the commit arrives, so
# this is the gate; commit-msg is only the early catch, because git skips it
# for `git commit -n`, cherry-pick, rebase picks, commit-tree and am
# (githooks(5)). The scan does not depend on gates.privateRepo (that list is
# for commit-msg): private, ask, a checker failure and a URL it cannot read
# OWNER/REPO from are all scanned, so an unset or mistyped list cannot turn
# the gate off. The commits scanned are those reachable from the pushed tip
# and not already on the target. "On the target" is asked of the target itself,
# once per push and only when a ref line has a non-zero local sha:
# `git ls-remote -- URL` (bounded by `timeout 20` when available). Every listed
# sha that exists locally as a commit is excluded, and so is each line's own
# remote sha. Local remote-tracking refs are not trusted: `git remote set-url`
# can point a name at a different repo and leave its old tracking refs behind.
# A commit that sits only on another remote (a mirror) is scanned. If
# ls-remote fails, only the lines' remote shas are excluded: that scans more,
# never less, and the push is not refused for the failure itself. A deleted ref
# is skipped. If rev-list, log or grep (status above 1) fails the push is
# refused. The scan is bytewise (xref.sh: LC_ALL=C grep -a), so an invalid byte
# on a line cannot hide a reference. A cross-reference
# hit is reported before the visibility verdict. GATES_PUBLIC_PUSH_OK does not
# skip this scan.
# Remaining bypass: `git push --no-verify` (or --no-veri) and a hooksPath
# override; an outer rule in your agent harness, if you run one, can ask
# before those. It checks against mistakes, not a hostile contributor.
#
# What it does: the host is taken from the URL (a trailing dot is dropped). For
# the ssh forms (git@host:path and ssh://) whose host is not already a GitHub
# name, it is resolved with `ssh -G -- HOST` (bounded by `timeout 5` when
# available; it connects to nothing, it only evaluates ssh config) and the
# first "hostname" line is used, so a Host alias for github.com is judged as
# GitHub. If ssh -G exits non-zero (a bad config, a timeout, ssh not found) or
# prints no hostname, the host is unknown: a stderr line says so and it takes
# the unknown path below (ssh -G also runs any `Match exec` in the config, so
# a slow one can time out). A host beginning with "-" is never passed to ssh.
# A host that is still not GitHub (another host) passes, after one stderr line
# "pre-push: not checked: host HOST is not GitHub"; a local path passes
# silently. A host that has a character outside [a-z0-9.-] (a %XX escape,
# which git decodes in URL-form hosts, an IPv6 literal, an underscore) is not
# "not GitHub" but unknown: it takes the unknown path below, scanned and
# refused unless approved. So does a path with a segment after OWNER/REPO (one
# trailing slash is fine; git removes /../ from an http path, so the repo
# contacted is not the one named) and a repo named X.wiki (the wiki of X; the
# checker's 404 would read as private). Only the default ssh config is read: if git is pointed at another
# one (core.sshCommand, GIT_SSH_COMMAND or GIT_SSH with -F FILE, or another
# program), an alias defined only there is not resolved and passes as "not
# checked". The ls-remote runs with GIT_TERMINAL_PROMPT=0, so it never asks
# for credentials a second time; without `timeout` it has no time limit.
# For a github.com URL (https, git@host:path and ssh:// forms) it runs
# check-visibility.sh OWNER REPO (once), found in the directory above this one.
# "private" passes. "public", "ask", any other output, a nonzero exit, or a
# URL it cannot read OWNER/REPO from is refused, because an unknown is not
# private. gist.github.com is GitHub but not a repo the checker can judge: it
# takes the unknown path (scanned, refused unless approved). Needs the network
# (curl, up to 20 s) on every push to GitHub.
# Approval: the owner's go-ahead is given as GATES_PUBLIC_PUSH_OK=yes on the
# push command, exactly "yes". Any other value does not count.
# The check script can be replaced by GATES_CHECK_VISIBILITY=PATH and the ssh
# used for host resolution by GATES_SSH=PATH (the test, test-git-hooks.sh,
# stubs both).
# Enable for every checkout on this machine, fork checkouts and temp clones
# too:
#   git config --global core.hooksPath /path/to/git-hooks
# Bypass of the visibility check: the approval above. `git push --no-verify`
# bypasses the whole hook.
xref_lib=$(dirname "$0")/xref.sh
if ! [ -r "$xref_lib" ]; then
    echo "pre-push: refused: cannot read $xref_lib (an unknown is not clean)" >&2
    exit 1
fi
# shellcheck source=xref.sh source-path=SCRIPTDIR
. "$xref_lib" || {
    echo "pre-push: refused: cannot source $xref_lib" >&2
    exit 1
}
refs=$(cat)

# is_zero SHA: all zeros (any hash length) or empty.
is_zero() {
    case $1 in
    *[!0]*) return 1 ;;
    *) return 0 ;;
    esac
}

# target_commits: prints each sha the target repo lists (git ls-remote) that
# exists here as a commit. Prints nothing if ls-remote fails.
target_commits() {
    if command -v timeout >/dev/null 2>&1; then
        _lr=$(GIT_TERMINAL_PROMPT=0 timeout 20 git ls-remote -- "$url" 2>/dev/null </dev/null) || return 0
    else
        _lr=$(GIT_TERMINAL_PROMPT=0 git ls-remote -- "$url" 2>/dev/null </dev/null) || return 0
    fi
    printf '%s\n' "$_lr" | awk 'NF {print $1}' |
        git cat-file --batch-check 2>/dev/null | awk '$2 == "commit" {print $1}'
}

# resolve_ssh_host HOST: prints the lowercased "hostname" ssh -G reports and
# returns 0; prints nothing and returns 0 for a host starting with "-" or an
# empty one (never passed to ssh). If ssh -G fails it prints nothing and
# returns its exit status (124 timeout, 127 not found); if it exits 0 without
# a non-empty "hostname" line it returns 253. The caller treats any non-zero
# as unknown, not as "not GitHub".
resolve_ssh_host() {
    case $1 in
    -* | '') return 0 ;;
    esac
    if command -v timeout >/dev/null 2>&1; then
        _g=$(timeout 5 "${GATES_SSH:-ssh}" -G -- "$1" 2>/dev/null </dev/null)
    else
        _g=$("${GATES_SSH:-ssh}" -G -- "$1" 2>/dev/null </dev/null)
    fi
    _grc=$?
    [ "$_grc" -eq 0 ] || return "$_grc"
    _gh=$(printf '%s\n' "$_g" | awk '$1 == "hostname" {print tolower($2); exit}' | sed 's/\.*$//')
    [ -n "$_gh" ] || return 253
    printf '%s\n' "$_gh"
}

# scan_push: reads the ref lines on stdin; prints each offending commit to
# stderr; returns 0 clean, 1 hits or a git failure.
scan_push() {
    bad=0
    ls_done=0
    remote_shas=''
    while read -r lref lsha _ rsha; do
        [ -n "${lref:-}" ] || continue
        is_zero "${lsha:-}" && continue
        if [ "$ls_done" -eq 0 ]; then
            ls_done=1
            remote_shas=$(target_commits)
        fi
        excl=$remote_shas
        if ! is_zero "${rsha:-}" && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
            excl=$(printf '%s\n%s\n' "$excl" "$rsha")
        fi
        if ! list=$({ printf '%s\n' "$lsha"; printf '%s\n' "$excl" | sed -n '/./s/^/^/p'; } |
            git rev-list --stdin 2>/dev/null); then
            echo "pre-push: refused: git rev-list failed for $lref ($lsha); an unknown is not clean" >&2
            bad=1
            continue
        fi
        for c in $list; do
            if ! body=$(git log -1 --format=%B "$c" 2>/dev/null) ||
                ! subj=$(git log -1 --format=%s "$c" 2>/dev/null); then
                echo "pre-push: refused: git log failed for commit $c; an unknown is not clean" >&2
                bad=1
                continue
            fi
            hit=$(printf '%s\n' "$body" | xref_grep)
            grc=$?
            if [ "$grc" -gt 1 ]; then
                echo "pre-push: refused: grep failed on commit $c (status $grc); an unknown is not clean" >&2
                bad=1
                continue
            fi
            if [ -n "$hit" ]; then
                short=$(git rev-parse --short "$c" 2>/dev/null || echo "$c")
                echo "pre-push: refused: GitHub cross-reference in commit $short $subj" >&2
                printf '%s\n' "$hit" | sed 's/^/pre-push:   line /' >&2
                bad=1
            fi
        done
    done
    [ "$bad" -eq 0 ]
}

url=${2:-}
host=''
path=''
viassh=0
case $url in
*://*)
    rest=${url#*://}
    hostpart=${rest%%/*}
    case $rest in */*) path=${rest#*/} ;; esac
    host=${hostpart##*@}
    host=${host%%:*}
    case ${url%%://*} in ssh | git+ssh | ssh+git) viassh=1 ;; esac
    ;;
*:*)
    # scp-like [user@]host:path, unless a slash comes first (a local path)
    pre=${url%%:*}
    case $pre in
    */*) ;;
    *)
        host=${pre##*@}
        path=${url#*:}
        viassh=1
        ;;
    esac
    ;;
esac
host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
while :; do
    case $host in
    *.) host=${host%.} ;;
    *) break ;;
    esac
done
odd=0
case $host in
github.com | www.github.com | ssh.github.com | gist.github.com) ;;
*)
    if [ "$viassh" -eq 1 ] && [ -n "$host" ]; then
        resolved=$(resolve_ssh_host "$host")
        rrc=$?
        if [ "$rrc" -ne 0 ]; then
            # ssh -G failed: the name ssh would contact is unknown, so the
            # alias is not judged "not GitHub"; same path as an odd host
            case $rrc in
            124) why='timed out after 5 s' ;;
            127) why='not found' ;;
            253) why='no hostname in its output' ;;
            *) why="exit status $rrc" ;;
            esac
            odd=1
            echo "pre-push: ssh -G $host failed ($why); host treated as unknown (fix the ssh config, or set GATES_SSH=PATH to the ssh that resolves it)" >&2
        else
            # the name ssh will contact is the one to judge, alias or not
            [ -z "$resolved" ] || host=$resolved
        fi
    fi
    case $host in
    github.com | www.github.com | ssh.github.com | gist.github.com) ;;
    *)
        # %XX and the like: git may decode the host to a GitHub name, so a
        # host outside [a-z0-9.-] is not "not GitHub", it is unknown
        case $host in
        *[!a-z0-9.-]*)
            odd=1
            echo "pre-push: host $host holds a character outside [a-z0-9.-]; treated as unknown" >&2
            ;;
        esac
        if [ "$odd" -eq 0 ]; then
            [ -z "$host" ] || echo "pre-push: not checked: host $host is not GitHub" >&2
            exit 0
        fi
        ;;
    esac
    ;;
esac

path=${path#/}
owner=''
repo=''
case $path in
*/*)
    owner=${path%%/*}
    repo=${path#*/}
    repo=${repo%%/*}
    # GitHub names are case-insensitive: r.WIKI.git is r.wiki.git
    repo=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')
    repo=${repo%.git}
    ;;
esac
# a repo named X.wiki is the wiki of the public-or-not repo X, not a repo the
# checker can judge (a 404 reads as private): the unknown path
case $repo in *.wiki) owner=''; repo='' ;; esac
# a segment after OWNER/REPO (/../PUBLIC): git may contact another repo
case $path in */*/?*) owner=''; repo='' ;; esac
# a % in the path: git may decode it (%2F), so OWNER and REPO are not as written
case $path in *%*) owner=''; repo='' ;; esac
# an undecodable host: the unknown path
[ "$odd" -eq 0 ] || { owner=''; repo=''; }
# a gist is GitHub but not a repo the checker can judge: the unknown path
if [ "$host" = gist.github.com ]; then
    owner=''
    repo=''
fi

word=unknown
if [ -n "$owner" ] && [ -n "$repo" ]; then
    check=${GATES_CHECK_VISIBILITY:-$(dirname "$0")/../check-visibility.sh}
    out=$("$check" "$owner" "$repo" 2>/dev/null)
    rc=$?
    case $out in
    public | ask) word=$out ;;
    esac
    [ "$rc" -eq 0 ] && [ "$out" = private ] && word=private
else
    owner=${owner:-?}
    repo=${repo:-?}
fi
target=$owner/$repo
[ "$host" != gist.github.com ] || target='gist.github.com (a gist, which the visibility checker cannot judge)'


# Everything but a repo the checker calls public is scanned, listed or not.
if [ "$word" != public ]; then
    if ! printf '%s\n' "$refs" | scan_push; then
        echo "pre-push: write 'owner/repo PR N' with no '#'; reword the commit (git commit --amend for the tip, or rebase) and push again" >&2
        exit 1
    fi
fi

[ "$word" = private ] && exit 0
if [ "${GATES_PUBLIC_PUSH_OK:-}" = yes ]; then
    echo "pre-push: push to $target ($word) is approved by GATES_PUBLIC_PUSH_OK=yes" >&2
    exit 0
fi
echo "pre-push: refused: $target is $word, not private (a public remote needs the owner's approval on every push, because publishing cannot be undone)." >&2
echo "pre-push: if the owner approved this push, give it on the command: GATES_PUBLIC_PUSH_OK=yes git push ..." >&2
exit 1
